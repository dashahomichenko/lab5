{
  "info": {
    "name": "Lab 5 Caching Proxy Server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET картинки, якої немає в кеші (200, MISS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type є image/jpeg', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image/jpeg'));",
              "pm.test('Джерело картинки — http.cat (X-Cache: MISS)', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/200"
      }
    },
    {
      "name": "2. Повторний GET тієї самої картинки (200, HIT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type є image/jpeg', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image/jpeg'));",
              "pm.test('Джерело картинки — кеш (X-Cache: HIT)', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/200"
      }
    },
    {
      "name": "3. PUT власної картинки в кеш (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 201 Created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "body": {
          "mode": "file",
          "file": {}
        },
        "url": "{{baseUrl}}/305"
      }
    },
    {
      "name": "4. GET після PUT (200, HIT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type є image/jpeg', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('image/jpeg'));",
              "pm.test('Джерело картинки — кеш (X-Cache: HIT)', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/305"
      }
    },
    {
      "name": "5. DELETE існуючої картинки з кешу (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/305"
      }
    },
    {
      "name": "6. DELETE картинки, якої немає в кеші (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/305"
      }
    },
    {
      "name": "7. GET неіснуючого коду стану (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 404 Not Found', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/999"
      }
    },
    {
      "name": "8. Запит із недозволеним методом POST (405)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Код стану 405 Method Not Allowed', () => pm.response.to.have.status(405));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/200"
      }
    }
  ]
}
